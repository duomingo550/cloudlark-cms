{
  "name": "cloudlark-cms",
  "version": "0.1.0-alpha.2",
  "description": "A lightweight, mixed-media CMS for AI founders, independent creators, and small businesses.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "cms",
    "headless-cms",
    "nextjs",
    "payloadcms",
    "typescript",
    "ai",
    "small-business",
    "multi-tenant"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duomingo550/cloudlark-cms.git"
  },
  "bugs": {
    "url": "https://github.com/duomingo550/cloudlark-cms/issues"
  },
  "homepage": "https://github.com/duomingo550/cloudlark-cms#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test:security": "node --experimental-strip-types --no-warnings scripts/security.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "graphql": "^16.11.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.5.1"
}
