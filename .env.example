# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-secret
# sqlite for local development / single-site self-hosting; postgres for SaaS
DATABASE_ADAPTER=sqlite
DATABASE_URL=file:./cloudlark.db
NEXT_PUBLIC_CMS_URL=http://localhost:3000
# Update this for every public domain before production deployment.
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_UNMATCHED_HOST_FALLBACK=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_RESET_ADMIN_PASSWORD=false
